# Build configuration for Packer EBS Ansible Builder generated by PackerEbsImageBuilder (pckr-ebs-ans)
build {
  name = "pckr-ebs-ans-block-000"
  sources = [
    "source.amazon-ebs.imgfile-coops-model"
  ]
  # Modifications for coops-model-packages of type bash-remote (shell)
  provisioner "shell" {
    only = ["amazon-ebs.imgfile-coops-model"]
    inline = [
      "for p in vim-enhanced mpdecimal; do rpm -q \"$p\" >/dev/null 2>&1 || dpkg -s \"$p\" >/dev/null 2>&1 || { command -v dnf >/dev/null 2>&1 && sudo dnf -y install \"$p\" || command -v yum >/dev/null 2>&1 && sudo yum -y install \"$p\" || sudo apt-get install -y \"$p\"; }; done",
      "( rpm -q amazon-efs-utils ) >/dev/null 2>&1 || { sudo dnf -y install git make rpm-build 'dnf-command(builddep)' && rm -rf /tmp/efs-utils && git clone https://github.com/aws/efs-utils /tmp/efs-utils && cd /tmp/efs-utils && git checkout \"$(git tag -l 'v1.*' --sort=-v:refname | head -1)\" && sudo dnf -y builddep ./amazon-efs-utils.spec && make rpm && sudo dnf -y install ./build/amazon-efs-utils*rpm && (sudo dnf -y remove git make rpm-build || true) && rm -rf /tmp/efs-utils; }",
    ]
  }
  # Modifications for coops-update-playbook of type ansible-default
  provisioner "shell" {
    only = ["amazon-ebs.imgfile-coops-model"]
    inline = [
      "test -x /usr/local/bin/csis-ansible-python || { for v in 3.12 3.11 3.9; do command -v python$v >/dev/null 2>&1 && break; sudo dnf -y install python$v >/dev/null 2>&1 && break; done; P=$(ls /usr/bin/python3.[0-9]* 2>/dev/null | grep -v config | sort -V | tail -1); [ -n \"$P\" ] || P=$(command -v python3); sudo ln -sf \"$P\" /usr/local/bin/csis-ansible-python; }",
    ]
  }
  provisioner "ansible" {
    only            = ["amazon-ebs.imgfile-coops-model"]
    playbook_file   = "playbooks/coops_update.yml"
    extra_arguments = ["-e", "ansible_python_interpreter=/usr/local/bin/csis-ansible-python"]
  }
  # identity activation for owning group 'coops' (okta)
  provisioner "shell" {
    only = ["amazon-ebs.imgfile-coops-model"]
    inline = [
      "# identity activation for group 'coops' (okta) on image imgfile-coops-model",
      "sudo mkdir -p /etc/sft",
      "printf 'Labels:\\n  tx.group: coops\\n' | sudo tee /etc/sft/sftd.yaml",
      "sudo systemctl enable sftd",
    ]
  }
  # local modification bundle for imgfile-coops-model -> /opt/csis/mods (re-run with `csis-mods rerun`)
  provisioner "shell" {
    only   = ["amazon-ebs.imgfile-coops-model"]
    inline = ["mkdir -p /tmp/csis-mods"]
  }
  provisioner "file" {
    only        = ["amazon-ebs.imgfile-coops-model"]
    source      = "csis-mods/imgfile-coops-model/"
    destination = "/tmp/csis-mods"
  }
  provisioner "shell" {
    only = ["amazon-ebs.imgfile-coops-model"]
    inline = [
      "sudo rm -rf /opt/csis/mods && sudo mkdir -p /opt/csis",
      "sudo mv /tmp/csis-mods /opt/csis/mods",
      "sudo install -m 0755 /opt/csis/mods/csis-mods /usr/local/bin/csis-mods",
      "sudo chmod -R go-w /opt/csis/mods",
    ]
  }
  # in-bake verification for instance image imgfile-coops-model: 7 assertion(s)
  provisioner "shell" {
    only = ["amazon-ebs.imgfile-coops-model"]
    inline = [
      "set -e",
      "# verify: activated for group 'coops'",
      "grep -q 'tx.group: coops' /etc/sft/sftd.yaml",
      "systemctl is-enabled sftd >/dev/null 2>&1",
      "if ! rpm -q vim-enhanced >/dev/null 2>&1 && ! { command -v dpkg >/dev/null 2>&1 && dpkg -s vim-enhanced >/dev/null 2>&1; }; then printf 'package %s is not installed\\n' vim-enhanced >&2; exit 1; fi",
      "if ! rpm -q mpdecimal >/dev/null 2>&1 && ! { command -v dpkg >/dev/null 2>&1 && dpkg -s mpdecimal >/dev/null 2>&1; }; then printf 'package %s is not installed\\n' mpdecimal >&2; exit 1; fi",
      "if ! rpm -q figlet >/dev/null 2>&1 && ! { command -v dpkg >/dev/null 2>&1 && dpkg -s figlet >/dev/null 2>&1; }; then printf 'package %s is not installed\\n' figlet >&2; exit 1; fi",
      "( vim --version ) 2>&1 | grep -q -- 'VIM - Vi IMproved'",
      "id -u csisadmin >/dev/null 2>&1",
    ]
  }
  post-processor "manifest" {
    output     = "manifest.json"
    strip_path = true
  }
}