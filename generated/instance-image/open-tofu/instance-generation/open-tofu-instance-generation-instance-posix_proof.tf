# Terraform module call for instance posix-proof generated by TofuInstanceBuilder (open-tofu)
# owning group: pxproof (via image imgfile-posix-proof); launch parameters recorded in meta-state/launch-params.yaml (N26)
module "instance_posix_proof" {
  source                      = "../../../../tfmodules/aws_instance"
  providers                   = { aws = aws.open_tofu }
  name                        = "posix-proof"
  ami_id                      = var.posix_proof_ami_id
  ami_name_pattern            = "imgfile-posix-proof-pckr-ebs-ans*"
  instance_type               = "t3.small"
  associate_public_ip_address = false
  vpc_security_group_ids      = [aws_security_group.csis_instances.id, "sg-03015ec107ae5f81a"]
  subnet_id                   = "subnet-09f79018af845358a"
  iam_instance_profile        = "AmazonSSMRoleForInstancesQuickSetup"
  tags                        = { "purpose" = "proof" }
  user_data = templatefile("${path.module}/user-data-posix_proof.sh.tftpl", {
    "ebs"                  = {}
    "efs"                  = {}
    "group_gid"            = 3101
    "sft_enrollment_token" = ""
  })
}