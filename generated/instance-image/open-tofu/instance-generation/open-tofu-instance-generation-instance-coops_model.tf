# Terraform module call for instance coops-model generated by TofuInstanceBuilder (open-tofu)
# owning group: coops (via image imgfile-coops-model); launch parameters recorded in meta-state/launch-params.yaml (N26)
module "instance_coops_model" {
  source                      = "../../../../../cs-image-system-3/tfmodules/aws_instance"
  providers                   = { aws = aws.open_tofu }
  name                        = "coops-model"
  ami_id                      = var.coops_model_ami_id
  ami_name_pattern            = "imgfile-coops-model-pckr-ebs-ans*"
  instance_type               = "c5n.4xlarge"
  associate_public_ip_address = false
  vpc_security_group_ids      = [aws_security_group.csis_instances.id, "sg-03015ec107ae5f81a"]
  subnet_id                   = "subnet-09f79018af845358a"
  iam_instance_profile        = "AmazonSSMRoleForInstancesQuickSetup"
  tags                        = { "group" = "coops", "purpose" = "model" }
  user_data = templatefile("${path.module}/user-data-coops_model.sh.tftpl", {
    "ebs" = {
      "mnt_data" = {
        "device_name" = "/dev/xvdf"
        "volume_id"   = data.terraform_remote_state.aws_ebs.outputs.storage_mnt_data.volume_id
      }
    }
    "efs" = {
      "efs-storage" = {
        "access_point_id" = data.terraform_remote_state.aws_efs.outputs.storage_efs_storage.access_point_ids["coops"]
        "file_system_id"  = data.terraform_remote_state.aws_efs.outputs.storage_efs_storage.file_system_id
      }
    }
    "group_gid"            = data.terraform_remote_state.oktagroups.outputs.group_gids["coops"]
    "sft_enrollment_token" = (var.sft_enrollment_token != "" ? var.sft_enrollment_token : data.terraform_remote_state.oktagroups.outputs.group_enrollment_tokens["coops"])
  })
  ebs_volumes = {
    "mnt_data" = {
      "device_name" = "/dev/xvdf"
      "volume_id"   = data.terraform_remote_state.aws_ebs.outputs.storage_mnt_data.volume_id
    }
  }
}